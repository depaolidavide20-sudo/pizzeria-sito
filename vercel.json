{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/instagram.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ],
  "redirects": [
    { "source": "/il-locale", "destination": "/storia.html", "statusCode": 301 },
    { "source": "/la-storia", "destination": "/storia.html", "statusCode": 301 },
    { "source": "/contact-us", "destination": "/contatti.html", "statusCode": 301 },
    { "source": "/contatti-e-orari", "destination": "/contatti.html", "statusCode": 301 },
    { "source": "/privacy-policy", "destination": "/privacy.html", "statusCode": 301 },
    { "source": "/pizze-senza-glutine", "destination": "/senza-glutine.html", "statusCode": 301 },
    { "source": "/menu", "destination": "/menu.html", "statusCode": 301 }
  ]
}
